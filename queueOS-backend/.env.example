PORT=5000

# PostgreSQL connection string (Prisma)
# Local: postgresql://user:password@localhost:5432/queueos_db?schema=public
# Render (Internal): postgresql://user:password@dpg-xxxx-a/queueos_db
# Render (External): postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/queueos_db?sslmode=require
DATABASE_URL=postgresql://queueos_user:queueos_password@localhost:5432/queueos_db?schema=public

# Redis connection
REDIS_URL=your_redis_host:your_redis_port
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

# JWT secret — use a long random string in production
JWT_SECRET=your_jwt_secret_key

# Python ML service URL
ML_API_URL=http://localhost:8000

# Set to "production" in prod — enables secure cookies and HTTPS-only flags
NODE_ENV=development

# Optional queue config
REDIS_QUEUE_TTL_SECONDS=3600
REDIS_QUEUE_LOAD_LIMIT=1000
